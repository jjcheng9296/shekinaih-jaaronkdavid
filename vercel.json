{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/egypt-2026.html",
      "destination": "/jt-foxx-mega-success-egypt-2026.html",
      "permanent": true
    },
    {
      "source": "/egypt-2026",
      "destination": "/jt-foxx-mega-success-egypt-2026.html",
      "permanent": true
    },
    {
      "source": "/italy-2026.html",
      "destination": "/italy-lamborghini-ferrari-museums-2026.html",
      "permanent": true
    },
    {
      "source": "/italy-2026",
      "destination": "/italy-lamborghini-ferrari-museums-2026.html",
      "permanent": true
    },
    {
      "source": "/dubai-2026.html",
      "destination": "/dubai-global-icon-awards-2026.html",
      "permanent": true
    },
    {
      "source": "/dubai-2026",
      "destination": "/dubai-global-icon-awards-2026.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:slug([a-z0-9-]+)",
      "destination": "/:slug.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; media-src 'self' https:; frame-src https://player.vimeo.com https://www.youtube.com https://www.youtube-nocookie.com; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(images|videos|captions|docs)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(favicon.svg|favicon.ico|apple-touch-icon.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}